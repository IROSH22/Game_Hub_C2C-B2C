# Game Hub Backend Environment Configuration Template
PORT=5000

# Database Connection (Local MongoDB or MongoDB Atlas Cloud)
# Local: mongodb://127.0.0.1:27017/gamehub
# Cloud Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gamehub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gamehub

# Cryptographic Token & PCI-DSS Signature Secret
JWT_SECRET=your_super_secret_jwt_key_here_gamehub_secure_vault

# EmailJS Free Real Email Integration (https://www.emailjs.com)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Optional Standard SMTP Fallback (e.g., Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
